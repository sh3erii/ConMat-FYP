# ConMat Final Backend Environment Example

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=7d

# PostgreSQL Databases
USERS_DB_URL=postgres://postgres:password@localhost:5432/conmat_users_db
PRODUCTS_DB_URL=postgres://postgres:password@localhost:5432/conmat_products_db
ORDERS_DB_URL=postgres://postgres:password@localhost:5432/conmat_orders_db
PAYMENTS_DB_URL=postgres://postgres:password@localhost:5432/conmat_payments_db
BIDS_DB_URL=postgres://postgres:password@localhost:5432/conmat_bids_db

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Stripe
STRIPE_SECRET_KEY=replace_with_stripe_secret
STRIPE_WEBHOOK_SECRET=replace_with_webhook_secret

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace_with_email
SMTP_PASS=replace_with_app_password
MAIL_FROM=ConMat <no-reply@conmat.local>
